MOD = 998244353

t = int(input())

for _ in range(t):
    n, k = map(int, input().split())

    q = list(map(int, input().split()))  # Q is identity, so we don't use it

    fact = 1

    for i in range(1, k + 1):
        fact = (fact * i) % MOD

    ans = fact * pow(k, n - k, MOD) % MOD

    print(ans)
